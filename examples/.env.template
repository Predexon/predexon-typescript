# @predexon/sdk examples — copy to .env and fill in your keys.
# .env is gitignored; never commit real keys.
PREDEXON_DATA_API_KEY=your_data_api_key_here       # data plane  → api.predexon.com
PREDEXON_TRADING_API_KEY=your_trading_api_key_here # trading plane → trade.predexon.com

# Optional: verbose HTTP request/response logging. ANY non-empty value enables
# it (z.coerce.boolean treats the string "false" as true), so leave it
# commented out to keep logging off.
# PREDEXON_DEBUG=1
